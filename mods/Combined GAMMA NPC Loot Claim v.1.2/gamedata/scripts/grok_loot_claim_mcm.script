-- MCM page for grok_loot_claim.script. Option values are read there via ui_mcm.get("grok_loot_claim/<id>").
-- Names:       ui_mcm_grok_loot_claim_<id>
-- Tooltips:    ui_mcm_grok_loot_claim_<id>_desc

function on_mcm_load()
	return {
		id = "grok_loot_claim",
		sh = true,
		gr = {
			{ id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_grok_loot_claim_title", size = { 512, 50 }, spacing = 20 },

			{ id = "enabled", type = "check", val = 1, def = true },

			{ id = "line_who", type = "line" },
			{ id = "header_who", type = "title", text = "ui_mcm_grok_loot_claim_header_who" },
			{ id = "player_loot_all", type = "check", val = 1, def = false },
			{ id = "npc_loot_all", type = "check", val = 1, def = false },
			{ id = "companions_are_player", type = "check", val = 1, def = true },
			{ id = "claim_mutants", type = "check", val = 1, def = true },

			{ id = "line_release", type = "line" },
			{ id = "header_release", type = "title", text = "ui_mcm_grok_loot_claim_header_release" },
			{ id = "release_killer_dead", type = "check", val = 1, def = true },
			{ id = "release_killer_far", type = "check", val = 1, def = true },
			{ id = "far_distance", type = "track", val = 2, min = 10, max = 150, step = 1, def = 35 },
			{ id = "release_after_loot", type = "check", val = 1, def = true },
			{ id = "release_delay", type = "track", val = 2, min = 0, max = 60, step = 1, def = 10 },

			{ id = "line_misc", type = "line" },
			{ id = "header_misc", type = "title", text = "ui_mcm_grok_loot_claim_header_misc" },
			{ id = "block_autolooter", type = "check", val = 1, def = true },
			{ id = "show_messages", type = "check", val = 1, def = true },

			{ id = "line_debug", type = "line" },
			{ id = "header_debug", type = "title", text = "ui_mcm_grok_loot_claim_header_debug" },
			{ id = "debug", type = "check", val = 1, def = false },
		}
	}
end
