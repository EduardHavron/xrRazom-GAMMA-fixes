--[[
  Workshop fix: ammo-type materials under-consumed. Not xrRazom-specific, works in solo.
  Split out of "zz xrRazom Fixes" (fix 6).
]]

local function L(fmt, ...) printf("[WSFIX] " .. fmt, ...) end

-- 6. workshop: ammo-type materials under-consumed (not xrRazom: Serious Workshop /
-- Craft From Stashes, happens in solo too) -------------------------------------------
-- Two partial boxes of a material that add up to a full one become a complexCraft
-- entry (both released, the remainder re-created). To compensate, Craft() then skips
-- releasing ONE full box of that section. That is right only when the full boxes
-- alone already reached the amount; when fewer full boxes than the amount were picked
-- (e.g. need 3: 2 full + 2 partials), one required box is never consumed.
-- Fix: for such a section run the complexCraft entry here and drop it from the list,
-- so Craft() releases every picked full box.

local function patch_workshop()
	local cls = ui_workshop and ui_workshop.UIWorkshopCraft
	if not (cls and cls.Craft and cls.UpdateItem) then
		L("workshop: UIWorkshopCraft missing, skipped")
		return
	end
	if cls.__xrrfix_wrapped then return end
	cls.__xrrfix_wrapped = true

	local orig_update = cls.UpdateItem
	cls.UpdateItem = function(self, n, sec, amount, result, ...)
		if not result then
			self.__xrrfix_need = self.__xrrfix_need or {}
			self.__xrrfix_need[n] = { sec = sec, amount = amount }
		end
		return orig_update(self, n, sec, amount, result, ...)
	end

	local orig_craft = cls.Craft
	cls.Craft = function(self, ...)
		pcall(function()
			if not (self.craft_allow_r and self.complexCraft and #self.complexCraft > 0 and self.__xrrfix_need) then
				return
			end
			for k = #self.complexCraft, 1, -1 do
				local cc = self.complexCraft[k]
				for n, need in pairs(self.__xrrfix_need) do
					local picked = self.craft_item and self.craft_item[n]
					if need.sec == cc.section and picked and need.amount and #picked < need.amount then
						alife_release_id(cc.id1)
						alife_release_id(cc.id2)
						if cc.newItemSize >= 1 then
							local stash_id = self.stashId or (self.owner and self.owner.stashId)
							local parent = stash_id and get_object_by_id(stash_id) or db.actor
							alife_create_item(cc.section, parent, { ammo = cc.newItemSize })
						end
						table.remove(self.complexCraft, k)
						L("workshop: %s merged partials handled, %s/%s full boxes consumed normally",
							cc.section, #picked, need.amount)
						break
					end
				end
			end
		end)
		return orig_craft(self, ...)
	end
	L("workshop: ammo material consumption patched")
end

function on_game_start()
	-- After every on_game_start: the workshop Craft chain is assembled by several mods there.
	RegisterScriptCallback("actor_on_first_update", function()
		local ok, err = pcall(patch_workshop)
		if not ok then L("install error: %s", tostring(err)) end
	end)
end
