--[[
  Task generation profiler (FX-TGEN, diagnostics). Install on the host and the peer.

  Times the task generation entry points and the task functions that GAMMA's task configs call
  as preconditions and on_job_descr, so the log shows where a Taskboard refresh (or a dialog)
  spends its time. Wraps once, on actor_on_first_update, after every on_game_start/on_game_load
  patch. Nested calls count in their callers too. After a burst (1 s without timed calls, at
  least 5 ms timed) it writes one summary and the most expensive functions:
    [XRRFIX] taskprof: <S> s, generate <N> calls <X> ms | memo <h>/<n> hits, bounty snapshots <b> built, <r> reused
    [XRRFIX] taskprof: #<i> <name> | total <X> ms | calls <N> | max <Y> ms
]]

local IDLE_MS = 1000
local MIN_MS = 5
local TOP = 8

-- task-specific preconditions and on_job_descr effects from GAMMA's task configs;
-- generic logic conditions (squad_exist, is_night, ...) are left alone
local CONDITIONS = {
	"has_completed_task_prerequisites", "validate_assault_task", "check_nta_replayability",
	"validate_measure_task", "intercept_artifact_check", "validate_spy_task",
	"validate_anomaly_scanner_field", "validate_dominance_task", "recover_mutant_data_precondition",
}
local EFFECTS = {
	"setup_assault_task", "setup_bounty_task", "drx_sl_create_quest_stash", "dispatch_nta_task_details",
	"setup_measure_task", "dispatch_intercept_artifact_task_details", "on_init_delivery_task",
	"setup_spy_task", "on_init_fate_task", "multifetch_on_job_descr", "setup_dominance_task",
	"recover_mutant_data_location", "dispatch_nta_stash_task_details",
}
local MANAGER = { "generate_available_tasks", "generate_ongoing_tasks", "trigger_fetch_func" }

local fmt = string.format
local function L(s) printf("%s", "[XRRFIX] taskprof: " .. s) end

local stats = {}         -- name -> { total = us, calls, max = us }
local timed_us = 0
local first_tg, last_tg = nil, nil
local timers = {}
local depth = 0

local function clock_us() return os.clock() * 1e6 end

-- Runs fn(...) under a timer; returns elapsed us and pcall's results.
local function timed(fn, ...)
	depth = depth + 1
	local t = profile_timer and timers[depth]
	if profile_timer and not t then t = profile_timer(); timers[depth] = t end
	local before = t and t:time() or clock_us()
	if t then t:start() end
	local res = { pcall(fn, ...) }
	if t then t:stop() end
	depth = depth - 1
	local us = t and (t:time() - before) or (clock_us() - before)
	return us, res
end

local function record(name, us)
	local s = stats[name]
	if not s then s = { total = 0, calls = 0, max = 0 }; stats[name] = s end
	s.total = s.total + us
	s.calls = s.calls + 1
	if us > s.max then s.max = us end
	if depth == 0 then timed_us = timed_us + us end
	local now = time_global()
	first_tg = first_tg or now
	last_tg = now
end

local function wrap(tbl, key, name)
	local orig = tbl and tbl[key]
	if type(orig) ~= "function" then return false end
	tbl[key] = function(...)
		local us, res = timed(orig, ...)
		record(name, us)
		if not res[1] then error(res[2], 0) end
		return unpack(res, 2, table.maxn(res))
	end
	return true
end

local function ms(us) return us / 1000 end

local function reset()
	stats, timed_us, first_tg, last_tg = {}, 0, nil, nil
end

local function report()
	local tgen = zz_xrrfix_tgen and zz_xrrfix_tgen.take_stats and zz_xrrfix_tgen.take_stats()
	if ms(timed_us) < MIN_MS then reset() return end
	local gen = stats["axr_task_manager.generate_available_tasks"] or { total = 0, calls = 0 }
	local memo = tgen and fmt("memo %d/%d hits, bounty snapshots %d built, %d reused",
		tgen.hits, tgen.hits + tgen.misses, tgen.built, tgen.reused) or "no tgen counters"
	L(fmt("%.1f s, generate %d calls %.0f ms | %s",
		(last_tg - first_tg) / 1000, gen.calls, ms(gen.total), memo))
	local list = {}
	for name, s in pairs(stats) do list[#list + 1] = { name = name, s = s } end
	table.sort(list, function(a, b) return a.s.total > b.s.total end)
	for i = 1, math.min(TOP, #list) do
		local e = list[i]
		L(fmt("#%d %s | total %.1f ms | calls %d | max %.1f ms", i, e.name, ms(e.s.total), e.s.calls, ms(e.s.max)))
	end
	reset()
end

local function on_update()
	if last_tg and time_global() - last_tg >= IDLE_MS then report() end
end

local function install()
	if axr_task_manager == nil or axr_task_manager.__xrrfix_taskprof then return end
	axr_task_manager.__xrrfix_taskprof = true
	local n = 0
	for _, k in ipairs(MANAGER) do
		if wrap(axr_task_manager, k, "axr_task_manager." .. k) then n = n + 1 end
	end
	for _, k in ipairs(CONDITIONS) do
		if wrap(xr_conditions, k, "xr_conditions." .. k) then n = n + 1 end
	end
	for _, k in ipairs(EFFECTS) do
		if wrap(xr_effects, k, "xr_effects." .. k) then n = n + 1 end
	end
	RegisterScriptCallback("actor_on_update", on_update)
	L(fmt("installed (%d functions timed)", n))
end

local function on_first_update()
	local ok, err = pcall(install)
	if not ok then L("install error: " .. tostring(err)) end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", on_first_update)
end
