--[[
	Quantity Craft and Transfer - "How many?" dialog
	Slider + manual input + -/+ / Max / OK / Cancel, Fallout: New Vegas style.

	qct_dialog.open({
		title = "st_qct_how_many",   -- string id
		name  = "Item name",         -- plain text (optional)
		info  = "Available: 12",     -- plain text (optional)
		info_func = function(n) end, -- text for the current value, overrides info (optional)
		sec   = "item_section",      -- icon (optional)
		max   = 12,                  -- >= 1
		value = 1,                   -- start value (optional)
		on_ok = function(n) end,     -- called after the dialog is closed
	})
--]]

local XML_FILE = "ui_qct_dialog.xml"

-- Panel size in 1024x768 UI units (width is squeezed on widescreen)
local PW, PH, PY = 440, 200, 250

-- 3t buttons and edit boxes draw their textures at the XML size and ignore SetWndSize,
-- so the XML carries one element set per aspect ratio; the nearest one is used.
local variants = { { "", 1 }, { "_16", 0.75 }, { "_21", 0.5625 } }

local function ui_variant()
	local w, h = device().width, device().height
	local k = math.min(1, (1024 / 768) / (w / h))
	local best = variants[1]
	for _, v in ipairs(variants) do
		if math.abs(v[2] - k) < math.abs(best[2] - k) then
			best = v
		end
	end
	return best[1], best[2]
end

local function place(el, x, y, w, h)
	el:SetWndPos(vector2():set(x, y))
	el:SetWndSize(vector2():set(w, h))
end


GUI = nil -- instance, don't touch

function open(p)
	if not (p and p.max and p.max >= 1) then
		return false
	end
	if (not GUI) then
		GUI = UIQtyDialog()
	end
	if GUI:IsShown() then
		return false
	end
	GUI:Open(p)
	return true
end

function is_open()
	return GUI and GUI:IsShown() and true or false
end


class "UIQtyDialog" (CUIScriptWnd)

function UIQtyDialog:__init() super()
	self.p = nil
	self.max = 1
	self.value = 1
	self:InitControls()
	self:InitCallBacks()
end

function UIQtyDialog:__finalize()
end

function UIQtyDialog:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)

	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)

	local sfx, k = ui_variant()
	local x0 = 512 - PW * k / 2
	local y0 = PY
	local function X(x) return x0 + x * k end
	local function W(w) return w * k end

	self.dim = xml:InitStatic("dim", self)
	place(self.dim, 0, 0, 1024, 768)

	self.panel = xml:InitStatic("panel" .. sfx, self)
	place(self.panel, x0, y0, W(PW), PH)
	self.frame = xml:InitFrame("frame" .. sfx, self)
	place(self.frame, x0, y0, W(PW), PH)

	self.title = xml:InitTextWnd("title" .. sfx, self)
	place(self.title, x0, y0 + 10, W(PW), 26)
	self.name = xml:InitTextWnd("name" .. sfx, self)
	place(self.name, x0, y0 + 36, W(PW), 22)

	self.icon_temp = xml:InitStatic("icon" .. sfx, self)
	place(self.icon_temp, X(16), y0 + 64, W(64), 64)
	self.icon = xml:InitStatic("icon" .. sfx, self)
	place(self.icon, X(16), y0 + 64, W(64), 64)

	self.btn_minus = xml:Init3tButton("btn_minus" .. sfx, self)
	place(self.btn_minus, X(96), y0 + 80, W(26), 26)
	self:Register(self.btn_minus, "qct_btn_minus")

	self.track = xml:InitTrackBar("track" .. sfx, self)
	place(self.track, X(128), y0 + 85, W(190), 16)
	self:Register(self.track, "qct_track")

	self.btn_plus = xml:Init3tButton("btn_plus" .. sfx, self)
	place(self.btn_plus, X(324), y0 + 80, W(26), 26)
	self:Register(self.btn_plus, "qct_btn_plus")

	self.input = xml:InitEditBox("input" .. sfx, self)
	place(self.input, X(358), y0 + 79, W(64), 28)
	self:Register(self.input, "qct_input")

	self.info = xml:InitTextWnd("info" .. sfx, self)
	place(self.info, X(96), y0 + 114, W(326), 20)

	self.btn_max = xml:Init3tButton("btn_max" .. sfx, self)
	place(self.btn_max, X(20), y0 + 152, W(120), 32)
	self:Register(self.btn_max, "qct_btn_max")

	self.btn_ok = xml:Init3tButton("btn_ok" .. sfx, self)
	place(self.btn_ok, X(160), y0 + 152, W(120), 32)
	self:Register(self.btn_ok, "qct_btn_ok")

	self.btn_cancel = xml:Init3tButton("btn_cancel" .. sfx, self)
	place(self.btn_cancel, X(300), y0 + 152, W(120), 32)
	self:Register(self.btn_cancel, "qct_btn_cancel")
end

function UIQtyDialog:InitCallBacks()
	self:AddCallback("qct_btn_ok",     ui_events.BUTTON_CLICKED,   self.OnOk,          self)
	self:AddCallback("qct_btn_cancel", ui_events.BUTTON_CLICKED,   self.OnCancel,      self)
	self:AddCallback("qct_btn_max",    ui_events.BUTTON_CLICKED,   self.OnMax,         self)
	self:AddCallback("qct_btn_minus",  ui_events.BUTTON_CLICKED,   self.OnMinus,       self)
	self:AddCallback("qct_btn_plus",   ui_events.BUTTON_CLICKED,   self.OnPlus,        self)
	self:AddCallback("qct_input",      ui_events.EDIT_TEXT_COMMIT, self.OnInputCommit, self)
end

function UIQtyDialog:Open(p)
	self.p = p
	self.max = math.max(1, math.floor(p.max))
	self.value = clamp(math.floor(tonumber(p.value) or 1), 1, self.max)

	self.title:SetText(game.translate_string(p.title or "st_qct_how_many"))
	self.name:SetText(p.name or "")
	self.info:SetText(p.info or "")

	-- A zero-length range breaks the track bar, so a single item gets a locked one
	if (self.max > 1) then
		self.track:Enable(true)
		self.track:SetStep(1)
		self.track:SetOptFBounds(1, self.max)
	else
		self.track:SetOptFBounds(0, 1)
		self.track:Enable(false)
	end
	self.btn_minus:Enable(self.max > 1)
	self.btn_plus:Enable(self.max > 1)
	self.btn_max:Enable(self.max > 1)

	if p.sec and ini_sys:section_exist(p.sec) then
		utils_xml.set_icon(p.sec, false, self.icon_temp, self.icon)
	else
		self.icon:Show(false)
	end

	self.track_last = nil
	self.input_last = nil
	self:SetValue(self.value)

	self:ShowDialog(true)
end

function UIQtyDialog:SetValue(n, from)
	n = math.floor(tonumber(n) or self.value)
	n = clamp(n, 1, self.max)
	self.value = n

	if (from ~= "track") then
		self.track:SetFValue((self.max > 1) and n or 1)
		self.track_last = n
	end
	if (from ~= "input") then
		local s = tostring(n)
		self.input:SetText(s)
		self.input_last = s
	end
	if self.p and self.p.info_func then
		local ok, txt = pcall(self.p.info_func, n)
		self.info:SetText(ok and txt or "")
	end
end

function UIQtyDialog:Update()
	CUIScriptWnd.Update(self)
	if not (self.p and self:IsShown()) then
		return
	end

	-- Slider moved by the player
	if (self.max > 1) then
		local tv = math.floor(self.track:GetFValue() + 0.5)
		if (tv ~= self.track_last) then
			self.track_last = tv
			self:SetValue(tv, "track")
		end
	end

	-- Text typed by the player: follow it live while it is a number, keep the text as typed
	local txt = self.input:GetText()
	if (txt ~= self.input_last) then
		self.input_last = txt
		local n = tonumber(txt)
		if n then
			self:SetValue(n, "input")
		end
	end
end

-- Returns the value from the input box, or nil when it is not a positive whole number
function UIQtyDialog:ReadInput()
	local n = tonumber(self.input:GetText())
	if (not n) or (n < 1) or (n ~= math.floor(n)) then
		return nil
	end
	return clamp(n, 1, self.max)
end

function UIQtyDialog:OnInputCommit()
	local n = self:ReadInput()
	self:SetValue(n or self.value)
end

function UIQtyDialog:OnMinus()
	self:SetValue(self.value - 1)
end

function UIQtyDialog:OnPlus()
	self:SetValue(self.value + 1)
end

function UIQtyDialog:OnMax()
	self:SetValue(self.max)
end

function UIQtyDialog:OnOk()
	local p = self.p
	if (not p) then
		return self:Close()
	end

	local n = self:ReadInput()
	if (not n) then
		-- Bad text: show the last valid value and keep the dialog open
		self:SetValue(self.value)
		return
	end

	self:Close()
	if p.on_ok then
		local ok, err = pcall(p.on_ok, n)
		if (not ok) then
			printe("!ERROR [QCT] dialog on_ok: %s", tostring(err))
		end
	end
end

function UIQtyDialog:OnCancel()
	self:Close()
end

function UIQtyDialog:Close()
	self.p = nil
	if self:IsShown() then
		self:HideDialog()
	end
end

function UIQtyDialog:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if (res == false) and (keyboard_action == ui_events.WINDOW_KEY_PRESSED) then
		if (dik == DIK_keys.DIK_ESCAPE) then
			self:OnCancel()
		elseif (dik == DIK_keys.DIK_RETURN) or (dik == DIK_keys.DIK_NUMPADENTER) then
			self:OnOk()
		elseif (dik == DIK_keys.DIK_LEFT) or (dik == DIK_keys.DIK_SUBTRACT) then
			self:OnMinus()
		elseif (dik == DIK_keys.DIK_RIGHT) or (dik == DIK_keys.DIK_ADD) then
			self:OnPlus()
		elseif (dik == DIK_keys.DIK_HOME) then
			self:SetValue(1)
		elseif (dik == DIK_keys.DIK_END) then
			self:OnMax()
		end
	end
	-- Modal: nothing falls through to the inventory / workshop below
	return true
end
