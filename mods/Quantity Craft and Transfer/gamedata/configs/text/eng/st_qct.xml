	<string id="ui_mcm_menu_qct">
		<text>Quantity Craft and Transfer</text>
	</string>
	<string id="ui_mcm_qct_desc">
		<text>"How many?" dialog for workshop crafting and for moving stacks in stashes and trade. Open it from the right-click menu or with the hotkey below. Ticked modifiers must be held, unticked ones must not, so Y, Alt+Y and Ctrl+Shift+Y are different binds.</text>
